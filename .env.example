# --- DATABASE CONFIGURATION ---
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=civicconnect
DB_HOST=localhost
DB_PORT=5432

# Production connection string fallback
DATABASE_URL=postgres://postgres:postgres@localhost:5432/civicconnect

# --- BACKEND SERVER SETTINGS ---
PORT=5000
NODE_ENV=development

# --- SECURITY & AUTHENTICATION ---
# Change secret in production!
JWT_SECRET=civicconnect_secret_jwt_key_2026
JWT_EXPIRES_IN=24h

# --- FRONTEND CONFIGURATIONS ---
# If using docker, this points to local backend exposing port 5000
VITE_API_URL=http://localhost:5000/api

# Optional: Add Google Maps API key to activate Google Embeds / JS Directions
VITE_GOOGLE_MAPS_API_KEY=
